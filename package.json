{
  "name": "dream-home-designer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @dhd/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "deploy:web": "pnpm --filter @dhd/web build && pnpm dlx wrangler@4.152.0 pages deploy apps/web/dist --project-name dream-home-designer"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
