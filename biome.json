{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/dist",
      "**/node_modules",
      "apps/api",
      ".claude",
      ".taste-skill",
      "**/test-results",
      "**/playwright-report",
      "tools/models/.cache",
      "apps/web/public/draco",
      "packages/core/src/fixtures/designer/cases"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "performance": {
        "noDelete": "off"
      }
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "overrides": [
    {
      "include": ["**/*.generated.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noApproximativeNumericConstant": "off"
          }
        }
      }
    },
    {
      "include": ["packages/ai/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": [
                  "document",
                  "window",
                  "navigator",
                  "localStorage",
                  "sessionStorage",
                  "indexedDB"
                ]
              }
            }
          }
        }
      }
    },
    {
      "include": ["apps/web/e2e/**"],
      "ignore": ["apps/web/e2e/test.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": "Import from './test': its `test` closes the browser contexts a test opens, so none is left drawing for the rest of the run."
                }
              }
            }
          }
        }
      }
    }
  ]
}
