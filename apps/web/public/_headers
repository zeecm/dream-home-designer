/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Furniture models are named by their content hash.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/*
  # Scripts only from here; data only to our API and the three AI providers a person may
  # bring a key for (their key is in this browser; nothing else may send it anywhere).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' blob: data: https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
